# Google Maps Platform Places API Key
# Optional: Paste your API key below if you wish to query live Google Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# YouTube Data API Key
# Optional: Paste your YouTube Data API key below for live YouTube bus video search
YOUTUBE_API_KEY=your_youtube_api_key_here

# Authorized Owner & Administrator Configuration
OWNER_EMAIL=owner@example.com
ADMIN_EMAILS=owner@example.com,admin@example.com

# SMTP Email Configuration for Owner Password Recovery (Optional)
# If left blank, password reset tokens are securely logged to backend/data/recovery_tokens.log
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Media Storage Configuration
MEDIA_STORAGE_PATH=backend/static
